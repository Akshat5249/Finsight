# FinSight .gitignore

# Environment — NEVER commit real secrets
.env
*.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Streamlit cache
.streamlit/

# Data (generated files — too large for git)
data/synthetic/actuals.xlsx
data/synthetic/budget.xlsx

# Reports (generated output)
backend/reports/

# IDE
.DS_Store
.idea/
.vscode/
*.swp

# Alembic version files generated by upgrades (keep the env.py and script.py.mako)
# (don't ignore alembic/versions/ — we want migrations in git)
