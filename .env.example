# FinSight — Environment Variable Reference
# Section 5 of the Full Technical Blueprint.
# Copy this file to .env and fill in real values.
# NEVER commit your real .env to git — it is git-ignored.

# ─────────────────────────────────────────────────────────────────────────────
# Database (Backend) — Supabase Postgres (recommended for deployment)
# ─────────────────────────────────────────────────────────────────────────────
# From Supabase: Project Settings → Database → Connection String (URI)
DATABASE_URL=postgresql+psycopg2://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider
# Set LLM_PROVIDER to "openrouter" or "openai"
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini

# If using OpenRouter:
OPENROUTER_API_KEY=your-openrouter-api-key-here

# If using OpenAI directly:
OPENAI_API_KEY=your-openai-api-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Qdrant Vector Store (Phase 5)
# Get URL and API key from your Qdrant Cloud dashboard
# ─────────────────────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION=finsight_facts

# ─────────────────────────────────────────────────────────────────────────────
# JWT Auth (Phase 7)
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=changeme-replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_API_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# Background Jobs (Phase 7 — Celery + Upstash Redis)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=rediss://your-upstash-redis-url-here
